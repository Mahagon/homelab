{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "abandonments:recommended",
    "group:recommended",
    ":configMigration",
    ":pinDevDependencies",
    ":gitSignOff"
  ],
  "prCreation": "immediate",
  "osvVulnerabilityAlerts": true,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "rebaseWhen": "conflicted",
  "internalChecksFilter": "none",
  "argocd": {
    "managerFilePatterns": [
      "/k8s/apps/.+/application\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/apps/.+/manifests/.+\\.yaml$/"
    ],
    "pinDigests": true
  },
  "terraform": {
    "managerFilePatterns": [
      "/infrastructure/opentofu/.+\\.tf$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "terraform"
      ],
      "groupName": "OpenTofu providers"
    },
    {
      "description": "Automerge tested non-major dependency updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Hold minor releases for three days before automerge so a compromised upstream release can be yanked first; patches and digests (where image security fixes land) merge as soon as CI passes",
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Argo CD's Redis override follows the chart's 8.6 line; only take patch releases",
      "matchPackageNames": [
        "ecr-public.aws.com/docker/library/redis"
      ],
      "allowedVersions": "/^8\\.6\\.\\d+-alpine$/"
    },
    {
      "description": "GitHub Actions run with deploy credentials, so every update waits three days; advisories still bypass this through vulnerabilityAlerts",
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/k8s/apps/home-assistant/manifests/home-assistant\\.yaml$/"
      ],
      "matchStrings": [
        "HACS_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "hacs/integration",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/renovate-compatibility\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+_VERSION: \\\"(?<currentValue>[^\\\"]+)\\\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/renovate-compatibility\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\s+RENOVATE_IMAGE: \\\"[^:\\\"]+:(?<currentValue>[^@\\\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\\\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/k8s/(bootstrap/argocd-values|apps/argocd/application)\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s+(?<depName>quay\\.io/argoproj/argocd):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/k8s/apps/argocd/application\\.yaml$/"
      ],
      "matchStrings": [
        "repository:\\s+(?<depName>ecr-public\\.aws\\.com/docker/library/redis)\\s+tag:\\s+(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
