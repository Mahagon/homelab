cloudflare_account_id = "0123456789abcdef0123456789abcdef"
cloudflare_zone_id    = "0123456789abcdef0123456789abcdef"
home_assistant_domain = "example.invalid"
budget_email          = "you@example.com"

# Zero Trust team name (<team>.cloudflareaccess.com) and the addresses allowed
# into the Grist meter-readings site; include your own (the cluster EMAIL).
cloudflare_access_team_name   = "your-team"
zaehlerstaende_allowed_emails = ["you@example.com", "neighbour@example.org"]

# Grafana Cloud -> Connections -> Data sources -> *-prom -> UID in the URL.
grafana_prometheus_datasource_uid = "grafanacloud-prom"

# Leave false until the cloudflared connectors report healthy.
publish_dns = false

# Add after ASK creates the skill, then apply a second time.
alexa_skill_id = ""
